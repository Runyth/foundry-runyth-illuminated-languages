{
  "id": "runyth-illuminated-languages",
  "title": "Runyth Illuminated Languages",
  "description": "Viewer-specific written-language rendering for Foundry journals and Illuminated Documents, powered by Polyglot.",
  "version": "1.0.10",
  "authors": [
    {
      "name": "Runyth",
      "url": "https://github.com/Runyth"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "13",
    "maximum": "13"
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/runyth-illuminated-languages.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "de",
      "name": "Deutsch",
      "path": "lang/de.json"
    }
  ],
  "relationships": {
    "requires": [
      {
        "id": "polyglot",
        "type": "module",
        "compatibility": {
          "minimum": "2.8.3",
          "verified": "2.8.3"
        }
      }
    ],
    "recommends": [
      {
        "id": "illuminated-documents",
        "type": "module",
        "compatibility": {
          "minimum": "1.9.0"
        }
      }
    ]
  },
  "license": "LICENSE",
  "readme": "README.md",
  "manifest": "https://github.com/Runyth/foundry-runyth-illuminated-languages/releases/latest/download/module.json",
  "download": "https://github.com/Runyth/foundry-runyth-illuminated-languages/releases/download/v1.0.10/runyth-illuminated-languages-v1.0.10-mod.zip",
  "url": "https://github.com/Runyth/foundry-runyth-illuminated-languages",
  "changelog": "CHANGELOG.md"
}
